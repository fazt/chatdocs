# Web de Folio (Next.js 16) — copia a apps/web/.env.local para desarrollo.
# URL pública (canonical, sitemap, Open Graph). Se incrusta en el build.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:5264
# Hacia dónde reenvía Next las llamadas /api/* (rewrites). En Docker: http://api:4095
API_INTERNAL_URL=http://127.0.0.1:4095
