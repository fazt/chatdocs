{
  "name": "@folio/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de Folio: Hono + Drizzle ORM + PostgreSQL/pgvector. Ingesta de PDF/DOCX con páginas, búsqueda híbrida, chat con citas verificadas, comparación, extracción de cláusulas, equipos y pagos.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-s3": "^3.800.0",
    "@hono/node-server": "^1.19.14",
    "@hono/zod-validator": "^0.8.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.25",
    "mammoth": "^1.13.0",
    "pg": "^8.21.0",
    "pino": "^10.4.0",
    "unpdf": "^1.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.10"
  }
}
