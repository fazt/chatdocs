# API de Folio — copia a apps/api/.env para desarrollo.
NODE_ENV=development
PORT=4095
HOST=127.0.0.1
# LOG_LEVEL=debug

# PostgreSQL 17 + pgvector del docker-compose.yml (puerto 5524 en el host).
DATABASE_URL=postgresql://folio:folio@127.0.0.1:5524/folio

# Mínimo 32 caracteres. En producción es obligatorio cambiarlo: openssl rand -base64 48
APP_SECRET=folio-dev-secret-cambia-esto-en-produccion

# URL pública de la web (emails, retorno de pagos) y por dónde llegan los webhooks.
APP_URL=http://127.0.0.1:5264
PUBLIC_API_URL=http://127.0.0.1:5264
# Orígenes permitidos para CORS y el chequeo anti-CSRF (separados por coma).
CORS_ORIGIN=http://127.0.0.1:5264,http://localhost:5264
COOKIE_SECURE=false
SESSION_DAYS=30
TRUST_PROXY=false

# --- IA ------------------------------------------------------------------------
# Sin claves funciona en MODO DEMO: embeddings por hashing y respuestas
# extractivas (citas literales de los documentos). Con claves usa modelos reales.
# auto = anthropic si hay ANTHROPIC_API_KEY; openai si hay OPENAI_API_KEY; si no, mock.
LLM_PROVIDER=auto
LLM_MAX_TOKENS=8000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_FALLBACKS=true
OPENAI_API_KEY=
# Cualquier API compatible con OpenAI (Ollama: http://localhost:11434/v1).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
# Embeddings: auto = openai si hay OPENAI_API_KEY; si no, mock. Deben ser de 1536 dimensiones.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small

# --- RAG -------------------------------------------------------------------------
CHUNK_CHARS=2400
CHUNK_OVERLAP_CHARS=300
RAG_TOP_K=8
RAG_CANDIDATES=40

# --- Ingesta y almacenamiento (los originales son PRIVADOS) --------------------------
MAX_UPLOAD_MB=25
MAX_PAGES_PER_DOCUMENT=1500
INGEST_CONCURRENCY=2
WORKERS_ENABLED=true
# local | s3 (S3, DigitalOcean Spaces, MinIO, R2…). Sin ACL pública.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Email -------------------------------------------------------------------------
# console = en desarrollo se muestran en el log (con el enlace); resend = envío real.
MAIL_DRIVER=console
RESEND_API_KEY=
MAIL_FROM=Folio <no-reply@folio.local>

# --- Pagos (siempre en modo test/sandbox) ---------------------------------------------
# Cada pasarela se activa solo si sus variables existen. La simulada es para la demo.
PAYMENTS_SIMULATED_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_CURRENCY=PEN
MERCADOPAGO_FX_RATE=3.75

# --- Seed ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@folio.local
SEED_ADMIN_PASSWORD=Admin12345!
SEED_DEMO=true
