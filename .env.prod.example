# Copia a .env.prod y cambia TODOS los secretos (openssl rand -base64 48).
WEB_PORT=8164
PUBLIC_URL=http://localhost:8164
# true si sirves la app por HTTPS (recomendado). En http://localhost déjalo en false.
COOKIE_SECURE=false

POSTGRES_USER=folio
POSTGRES_PASSWORD=cambia-esta-clave-de-postgres
POSTGRES_DB=folio

APP_SECRET=genera-un-secreto-largo-de-al-menos-32-caracteres

# IA: sin claves funciona en modo demo (respuestas extractivas con citas literales).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
OPENAI_API_KEY=

# Almacenamiento de originales (privado): local (volumen) o s3.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email (invitaciones, recuperar contraseña): console | resend
MAIL_DRIVER=console
RESEND_API_KEY=
MAIL_FROM=Folio <no-reply@tu-dominio.com>

# Pagos (sandbox). La pasarela simulada está APAGADA en producción salvo que la actives.
PAYMENTS_SIMULATED_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_CURRENCY=PEN
MERCADOPAGO_FX_RATE=3.75

# Seed al arrancar (idempotente, no borra datos). SEED_DEMO=true carga el estudio jurídico de demo.
SEED_ON_START=true
SEED_DEMO=false
SEED_ADMIN_EMAIL=admin@tu-dominio.com
SEED_ADMIN_PASSWORD=cambia-esta-clave-de-admin
