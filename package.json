{
  "name": "folio",
  "version": "1.0.0",
  "private": true,
  "description": "Folio: chat con documentos con citas verificables por página para equipos legales, de cumplimiento e investigación.",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @folio/api --filter @folio/web dev",
    "dev:api": "pnpm --filter @folio/api dev",
    "dev:web": "pnpm --filter @folio/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @folio/api db:migrate",
    "db:seed": "pnpm --filter @folio/api db:seed"
  }
}
